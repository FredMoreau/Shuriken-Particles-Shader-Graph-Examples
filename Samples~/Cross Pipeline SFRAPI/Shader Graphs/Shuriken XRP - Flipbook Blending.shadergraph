{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7ce49bbc7b6e40bc80bfa628eeca5d79",
    "m_Title": "Particle UV, UV2 & Blend",
    "m_Content": "Using a custom function similar to what's in Packages/com.unity.render-pipelines.universal/ShaderLibrary/Particles.hlsl to get the particle's UV coords accounting for Texture Sheet Animation module settings, and passing it from vertex to fragment stage with a Custom Interpolator.\n\nUV2 stores the UV at frame n+1, while Blend stores the blend amount between current frame and frame n+1.\n\nWhen GPU Instancing is enabled, UV and UV2 are offset using Texture Sheet Animation settings and AnimFrame (read from Particle Data Struct), and AnimBlend is equivalent to frac(AnimFrame).\n\nWhen GPU Instancing is disabled, UV and UV2 are pre offset in the vertex data, and AnimBlend is stored in TEXCOORDX.x.\nSee the Particle Renderer Custom Vertex Stream to see in which channel/component it is stored.\n\nThe VertexStreamSource subgraph helps picking the channel/component.",
    "m_TextSize": 0,
    "m_Theme": 1,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1879.0,
        "y": 316.0,
        "width": 514.0,
        "height": 282.0
    },
    "m_Group": {
        "m_Id": "b59dc32c41ea4b1098bded6d6ca2cdb6"
    }
}

